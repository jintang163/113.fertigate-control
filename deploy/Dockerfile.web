# 前端镜像：node 构建 → nginx 静态托管，/api 反代到 cloud-backend
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install --registry=https://registry.npmmirror.com
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# nginx 反代配置由 docker-compose 以只读卷挂载（deploy/nginx.conf）
EXPOSE 80
